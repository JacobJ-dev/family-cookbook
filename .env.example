# Copy this file to .env.local and fill in the values from the Supabase dashboard:
#   Project URL     → Project Settings → Data API (or the "Connect" button)
#   Publishable key → Project Settings → API Keys (starts with sb_publishable_)
# .env.local is gitignored. Never put the secret key (sb_secret_...) here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
