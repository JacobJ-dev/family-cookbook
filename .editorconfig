# Editor settings shared by everyone who opens the project (https://editorconfig.org).
# VS Code needs the "EditorConfig for VS Code" extension to read this file.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

# Files mostly written by tools (npm, Supabase CLI) keep their 2-space default.
[*.{json,md,toml,yml,yaml}]
indent_size = 2
